<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- "New in your playlist" alerts and programme reminders (asked once; Android 13+). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Android TV: put part-watched films and episodes in the home screen's "Play next" row. -->
    <uses-permission android:name="com.android.providers.tv.permission.WRITE_EPG_DATA" />
    <!-- Listen mode (phones, off unless chosen): the sound plays on with the screen off. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Downloads (films and episodes to watch offline) carry on in the background. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />

    <!-- Voice search: is there a speech recognizer on this device (Android 11+ asks apps to say what they look for)? -->
    <queries>
        <intent>
            <action android:name="android.speech.action.RECOGNIZE_SPEECH" />
        </intent>
    </queries>

    <!-- Runs on phones, tablets and Android TV boxes -->
    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <!-- enableOnBackInvokedCallback=false: on Android 16 the remote's Back key keeps reaching the
         player (closing the channel list, hiding the controls) instead of leaving the screen. -->
    <application
        android:name=".FalakApp"
        android:label="@string/app_name"
        android:icon="@drawable/ic_launcher"
        android:roundIcon="@drawable/ic_launcher"
        android:banner="@drawable/tv_banner"
        android:theme="@style/Theme.Falak"
        android:usesCleartextTraffic="true"
        android:enableOnBackInvokedCallback="false"
        android:largeHeap="true"
        android:supportsRtl="true">

        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.PlayerActivity"
            android:exported="false"
            android:launchMode="singleTask"
            android:resizeableActivity="true"
            android:supportsPictureInPicture="true"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|keyboard|navigation"
            android:theme="@style/Theme.Falak.Player" />

        <!-- Listen mode: the sound of what was playing, carried on in the background. -->
        <service
            android:name=".ListenService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />

        <!-- Downloads run as background work shown as a download in progress (Android 14+ needs its type). -->
        <service
            android:name="androidx.work.impl.foreground.SystemForegroundService"
            android:foregroundServiceType="dataSync"
            tools:node="merge" />

        <!-- "Another app" as the player: hands it a downloaded file to play. -->
        <provider
            android:name=".OfflineFiles"
            android:authorities="${applicationId}.offline"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/offline_paths" />
        </provider>

        <!-- Programme reminders while the app is closed (an ordinary, inexact alarm). -->
        <receiver
            android:name=".AlertReceiver"
            android:exported="false" />
    </application>
</manifest>
