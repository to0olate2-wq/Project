<resources>
    <style name="Theme.Falak" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:colorAccent">@color/accent</item>
    </style>

    <!-- Only while the app starts (MainActivity switches to Theme.Falak at once): the logo, not a blank screen. -->
    <style name="Theme.Falak.Launch">
        <item name="android:windowBackground">@drawable/launch_screen</item>
    </style>
    <style name="Theme.Falak.Player">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:windowFullscreen">true</item>
    </style>
</resources>
